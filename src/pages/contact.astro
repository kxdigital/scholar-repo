---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Contact Us">
  <h1 style="color: #2c3e50;">Contact Us</h1>
  <p style="font-size: 16px; color: #555; line-height: 1.8;">
    For inquiries, manual request assistance, or reporting technical issues, please reach out to our administration team.
  </p>
  
  <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; border: 1px solid #ddd; margin-top: 20px;">
    <ul style="list-style-type: none; padding: 0; margin: 0; font-size: 16px; color: #444;">
      <li style="margin-bottom: 10px;">📧 <strong>Email:</strong> admin@visitlink.net</li>
      <li style="margin-bottom: 10px;">🕒 <strong>Support Hours:</strong> Monday - Friday, 09:00 - 17:00 (WIB)</li>
    </ul>
  </div>
</MainLayout>