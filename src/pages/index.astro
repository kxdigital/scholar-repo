---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Home">
  <h1>Welcome to ScholarRepo</h1>
  <p>Search and explore millions of academic documents, journal metadata, and abstracts efficiently.</p>
  
  <div style="margin-top: 30px; padding: 20px; background: #f8f9fa; border-radius: 6px; border: 1px solid #eee;">
    <p>To view an article, append the DOI to our URL.</p>
    <code>Example: yourdomain.com/jurnal/10.1038/s41401-024-01339-z</code>
  </div>
</MainLayout>