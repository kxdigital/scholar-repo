---
export const prerender = false;
import MainLayout from '../layouts/MainLayout.astro';

const query = Astro.url.searchParams.get('q')?.trim() || '';

// 1. FITUR BARU: Deteksi Otomatis jika input adalah DOI
// Regex ini membaca pola standar DOI yang selalu diawali angka 10.
const doiRegex = /(10\.\d{4,9}\/[-._;()/:A-Z0-9]+)/i;
const doiMatch = query.match(doiRegex);

// Jika cocok dengan pola DOI, langsung lempar ke halaman artikel (tanpa loading daftar pencarian)
if (doiMatch) {
  return Astro.redirect(`/jurnal/${doiMatch[0]}`);
}

let results = [];
let totalResults = 0;

if (query) {
  // 2. Modifikasi pencarian agar lebih memprioritaskan Judul (mengurangi hasil abstrak yang melenceng)
  const apiUrl = `https://api.openalex.org/works?search=${encodeURIComponent(query)}&per-page=10&mailto=admin@kxdigital.com`;
  const response = await fetch(apiUrl);
  
  if (response.ok) {
    const data = await response.json();
    results = data.results || [];
    totalResults = data.meta?.count || 0;
  }
}
---

<!-- Sisa kode HTML Anda di bawahnya tetap sama seperti sebelumnya -->
<MainLayout title={`Search: ${query}`}>
  
  <h2 style="color: #2c3e50; border-bottom: 2px solid #eee; padding-bottom: 10px;">
    Search Results for: <em>"{query}"</em>
  </h2>

  {query === '' && (
    <p style="color: #666;">Please enter a keyword to search.</p>
  )}

  {query !== '' && results.length === 0 && (
    <p style="color: red;">No results found. Try a different keyword.</p>
  )}

  {results.length > 0 && (
    <p style="color: #888; font-size: 14px;">Found {totalResults.toLocaleString()} results (showing top 10)</p>
  )}

  <div style="display: flex; flex-direction: column; gap: 20px; margin-top: 20px;">
    {results.map((item) => {
      const rawDoi = item.doi ? item.doi.replace('https://doi.org/', '') : null;
      
      return (
        <div style="background: #f8f9fa; padding: 15px; border-radius: 6px; border: 1px solid #ddd;">
          <h3 style="margin: 0 0 10px 0; font-size: 18px;">
            {rawDoi ? (
              <a href={`/jurnal/${rawDoi}`} style="color: #2980b9; text-decoration: none;">{item.title || "No Title"}</a>
            ) : (
              <span style="color: #333;">{item.title || "No Title"} (No DOI Available)</span>
            )}
          </h3>
          
          <div style="font-size: 14px; color: #555;">
            <span style="margin-right: 15px;">📅 <strong>{item.publication_year}</strong></span>
            <span>📚 <strong>{item.primary_location?.source?.display_name || "Unknown"}</strong></span>
          </div>
          
          {rawDoi && (
            <div style="margin-top: 10px;">
              <a href={`/jurnal/${rawDoi}`} style="display: inline-block; padding: 5px 10px; background: #2ecc71; color: white; text-decoration: none; border-radius: 4px; font-size: 12px; font-weight: bold;">
                View Details & Abstract
              </a>
            </div>
          )}
        </div>
      )
    })}
  </div>

</MainLayout>