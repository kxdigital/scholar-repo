---
export const prerender = false;
import MainLayout from '../../layouts/MainLayout.astro';

// Mengambil parameter dari URL dinamis
const { path } = Astro.params;

// Menggabungkan array path jika ada, lalu men-decode karakter seperti %2F menjadi garis miring (/)
const rawPath = Array.isArray(path) ? path.join('/') : (path || '');
const cleanId = decodeURIComponent(rawPath).trim();

// Endpoint Crossref API
const apiUrl = `https://api.crossref.org/works/${encodeURIComponent(cleanId)}`;

let data = {};
let isError = false;

try {
  const response = await fetch(apiUrl, {
    headers: {
      'User-Agent': 'VisitLink/1.0 (https://visitlink.net; mailto:admin@kxdigital.com)'
    }
  });

  if (response.ok) {
    const json = await response.json();
    data = json.message || {};
  } else {
    isError = true;
  }
} catch (err) {
  isError = true;
}

const judul = data.title?.[0] || "Title not available";
const urlAsli = data.DOI ? `https://doi.org/${data.DOI}` : "-";
const tahun = data['published-print']?.['date-parts']?.[0]?.[0] || data['published-online']?.['date-parts']?.[0]?.[0] || "Unknown Year";
const namaPenerbit = data.publisher || "Unknown Publisher";
const namaJurnal = data['container-title']?.[0] || "";

// Mengambil Direct PDF Link dari Crossref
let pdfUrl = "";
if (data.link && data.link.length > 0) {
  const pdfLinkObj = data.link.find(l => l['content-type'] === 'application/pdf');
  if (pdfLinkObj) {
    pdfUrl = pdfLinkObj.URL;
  }
}
if (!pdfUrl && data.DOI) {
  pdfUrl = `https://doi.org/${data.DOI}`;
}

let pengarang = "Unknown Author";
let authorList = [];
if (data.author && data.author.length > 0) {
  authorList = data.author.map(a => `${a.given || ''} ${a.family || ''}`.trim()).filter(Boolean);
  pengarang = authorList.join(', ') || "Unknown Author";
}

let abstrak = "Abstract not available for this article.";
if (data.abstract) {
  abstrak = data.abstract.replace(/<[^>]*>?/gm, '');
}

const currentUrl = `https://visitlink.net/jurnal/${cleanId}`;
---

<MainLayout title={isError ? "Article Not Found" : judul}>
  
  {/* SEO Meta Tags & Google Scholar */}
  <Fragment slot="head">
    <meta name="description" content={abstrak.substring(0, 160) + "..."} />
    <link rel="canonical" href={currentUrl} />

    <meta property="og:title" content={judul} />
    <meta property="og:description" content={abstrak.substring(0, 160) + "..."} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:type" content="article" />

    {!isError && (
      <>
        <meta name="citation_title" content={judul} />
        {authorList.map(auth => (
          <meta name="citation_author" content={auth} />
        ))}
        <meta name="citation_publication_date" content={tahun} />
        {namaJurnal && <meta name="citation_journal_abbrev" content={namaJurnal} />}
        <meta name="citation_doi" content={cleanId} />
        {pdfUrl && <meta name="citation_pdf_url" content={pdfUrl} />}
      </>
    )}
  </Fragment>

  {isError ? (
    <div style="text-align: center; padding: 50px 20px; background: #fff3f3; border-radius: 8px; border: 1px solid #ffcdd2;">
      <h1 style="color: #c0392b; margin-top: 0; font-size: 28px;">Article Not Found</h1>
      <p style="color: #555; font-size: 16px; margin-top: 15px;">
        We couldn't find any article associated with the DOI: <br/>
        <strong style="font-size: 20px; color: #333; display: block; margin-top: 10px;">{cleanId}</strong>
      </p>
      <p style="color: #777; font-size: 14px; margin-top: 25px;">
        Please check if the DOI is typed correctly, or try searching using the title or author name.
      </p>
    </div>
  ) : (
    <>
      <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
        <span style="background: #3498db; color: white; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: bold;">
          DOI: {cleanId}
        </span>

        {pdfUrl && (
          <a href={pdfUrl} target="_blank" rel="noopener noreferrer" style="background: #27ae60; color: white; padding: 6px 16px; border-radius: 4px; font-size: 13px; text-decoration: none; font-weight: bold; display: inline-flex; align-items: center; gap: 6px;">
            📄 View / Download PDF
          </a>
        )}
      </div>
      
      <h1 style="margin-top: 15px; font-size: 28px; line-height: 1.4; color: #1a1a1a;">
        {judul}
      </h1>
      
      <ul style="list-style-type: none; padding: 0; margin-top: 25px; color: #444; line-height: 1.6;">
        <li style="margin-bottom: 10px;">👤 <strong>Authors:</strong> {pengarang}</li>
        {namaJurnal && <li style="margin-bottom: 10px;">📖 <strong>Journal:</strong> {namaJurnal}</li>}
        <li style="margin-bottom: 10px;">📚 <strong>Publisher:</strong> {namaPenerbit}</li>
        <li style="margin-bottom: 10px;">📅 <strong>Publication Year:</strong> {tahun}</li>
        <li style="margin-bottom: 10px;">🔗 <strong>DOI Link:</strong> <a href={urlAsli} target="_blank" style="color: #3498db; text-decoration: none;">{urlAsli}</a></li>
      </ul>

      <hr style="margin: 35px 0 25px 0; border: 0; border-top: 1px solid #eaeaea;" />
      
      <h3 style="margin-bottom: 15px; color: #2c3e50;">Abstract</h3>
      <p style="text-align: justify; font-size: 16px; color: #555; line-height: 1.8;">
        {abstrak}
      </p>
    </>
  )}

</MainLayout>